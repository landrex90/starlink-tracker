DATABASE_URL=postgres://user:password@host:5432/dbname

# bcrypt hash of the single admin password (never store the plain password)
ADMIN_PASSWORD_HASH=

# random string used to sign the session cookie
SESSION_SECRET=

# shared secret the scheduled sync cron job uses to call /api/starlink/sync
# without a browser session. Leave unset locally if you don't need cron testing.
CRON_SECRET=

# JSON array of Starlink Enterprise service accounts to sync from.
# Leave empty/unset to run the app fully in mock mode.
# Each account needs "Service plan, View" and "Device management, View" permissions.
# STARLINK_ACCOUNTS=[{"label":"My Org","clientId":"...","clientSecret":"..."}]
STARLINK_ACCOUNTS=
